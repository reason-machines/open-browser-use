{
  "name": "obu-agent",
  "version": "0.0.1",
  "private": true,
  "description": "Open Browser Use agent daemon: sessions, tab leases, CDP, snapshots, actions and waiting for AI agents.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "obu-agent": "dist/daemon/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-injected.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm build && node --test test/*.test.mjs",
    "fixtures": "node fixtures/server.mjs",
    "test:live": "pnpm build && node test/daemon-live.mjs",
    "build:injected": "node scripts/build-injected.mjs",
    "e2e": "pnpm build && node --test --test-reporter=spec e2e/all.test.mjs",
    "e2e:strict": "pnpm build && E2E_STRICT=1 node --test --test-reporter=spec e2e/all.test.mjs",
    "e2e:fixtures": "pnpm build && E2E_SUITES=fixtures node --test --test-reporter=spec e2e/all.test.mjs",
    "bench:micro": "pnpm build && node e2e/bench/micro.mjs",
    "bench:compare": "node e2e/bench/compare.mjs"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "acorn": "^8.15.0"
  }
}
